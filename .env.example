POSTGRES_DB=footballqa
POSTGRES_USER=football
POSTGRES_PASSWORD=football
POSTGRES_PORT=5433
API_PORT=8001
FRONTEND_PORT=5174
HOST_BIND_IP=127.0.0.1
DATABASE_URL=postgresql+psycopg://football:football@localhost:5433/footballqa
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
# Mode simulé (par défaut, utilisé par la CI et la campagne V1) :
#   MOCK_FOOTBALL_API=true  -> 6 championnats, 4 équipes par classement, aucun quota.
# Mode réel : créer un compte gratuit sur https://www.football-data.org/client/register,
# renseigner FOOTBALL_API_TOKEN ci-dessous puis passer MOCK_FOOTBALL_API à false.
# Ne jamais versionner le jeton réel.
FOOTBALL_API_TOKEN=replace-with-your-football-data-org-token
FOOTBALL_CACHE_TTL_SECONDS=300
MOCK_FOOTBALL_API=true
CORS_ORIGINS=http://localhost:5174
