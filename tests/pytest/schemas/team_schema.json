{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fiche équipe",
  "type": "object",
  "required": ["id", "name", "crest"],
  "properties": {
    "id": { "type": "integer" },
    "name": { "type": "string", "minLength": 1 },
    "crest": { "type": "string" },
    "venue": { "type": ["string", "null"] },
    "website": { "type": ["string", "null"] }
  }
}
