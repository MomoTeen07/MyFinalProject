{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Équipe favorite",
  "type": "object",
  "required": ["id", "team_id", "team_name", "created_at"],
  "properties": {
    "id": { "type": "integer", "minimum": 1 },
    "team_id": { "type": "integer", "minimum": 1 },
    "league_code": { "type": ["string", "null"] },
    "team_name": { "type": "string", "minLength": 1 },
    "team_crest": { "type": ["string", "null"] },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}" }
  }
}
