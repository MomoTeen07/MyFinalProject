{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Calendrier paginé d'un championnat",
  "type": "object",
  "required": ["items", "total", "page", "page_size", "total_pages"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "utcDate", "status", "homeTeam", "awayTeam"],
        "properties": {
          "id": { "type": "integer" },
          "utcDate": { "type": "string", "minLength": 10 },
          "status": { "type": "string" },
          "homeTeam": {
            "type": "object",
            "required": ["id", "name"],
            "properties": {
              "id": { "type": "integer" },
              "name": { "type": "string", "minLength": 1 }
            }
          },
          "awayTeam": {
            "type": "object",
            "required": ["id", "name"],
            "properties": {
              "id": { "type": "integer" },
              "name": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "total": { "type": "integer", "minimum": 0 },
    "page": { "type": "integer", "minimum": 1 },
    "page_size": { "type": "integer", "minimum": 1 },
    "total_pages": { "type": "integer", "minimum": 0 }
  }
}
