{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Calendrier d'un championnat",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "utcDate", "status", "homeTeam", "awayTeam"],
    "properties": {
      "id": { "type": "integer" },
      "utcDate": { "type": "string", "minLength": 10 },
      "status": { "type": "string" },
      "homeTeam": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string", "minLength": 1 }
        }
      },
      "awayTeam": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
